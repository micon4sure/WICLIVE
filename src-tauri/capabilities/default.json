{
  "$schema": "https://raw.githubusercontent.com/nicollassilva/tauri-v2/main/tooling/cli/schema.json",
  "identifier": "default",
  "description": "Default capabilities for WIC LIVE",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "dialog:default",
    "opener:default"
  ]
}
