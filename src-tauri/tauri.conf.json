{
  "$schema": "https://raw.githubusercontent.com/nicollassilva/tauri-v2/main/tooling/cli/schema.json",
  "productName": "WIC LIVE",
  "version": "4.5.1",
  "identifier": "wiclive.techtile.media",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "WIC LIVE",
        "width": 1770,
        "height": 930,
        "minWidth": 1770,
        "minHeight": 930,
        "decorations": false,
        "transparent": false,
        "backgroundColor": [5, 10, 15, 255]
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": "v1Compatible",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVEN0UwOTY0NUJCMTM0N0YKUldSL05MRmJaQWwrWFhOWUErQTdnMUc1NDV3QlhoTGM5K1hIbmxiMXRKMFlheWVoQ05BeHN6aGEK",
      "endpoints": [
        "https://github.com/micon4sure/WICLIVE/releases/latest/download/version.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
